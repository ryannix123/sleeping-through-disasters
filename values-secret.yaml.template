# Secrets for Sleeping Through Disasters.
#
# Copy this file OUTSIDE the repository and fill it in:
#   cp values-secret.yaml.template ~/values-secret-sleeping-through-disasters.yaml
# `./pattern.sh make install` (or `make load-secrets`) loads it into Vault on
# the hub; External Secrets delivers each secret to the sites that need it.
# Never commit real values. Everything below except Cloudflare is generated.
#
# Format: https://validatedpatterns.io/learn/secrets-management-in-the-validated-patterns-framework/
version: "2.0"

vaultPolicies:
  # 64 hex digits for the VolSync rsync-tls pre-shared key (stunnel PSK).
  hexKey: |
    length=64
    rule "charset" { charset = "0123456789abcdef" min-chars = 1 }

secrets:
  # Odoo's master (database manager) password and the admin user's login.
  # Global: both sites run Odoo (the passive one only after failover).
  - name: odoo-admin
    vaultPrefixes:
      - global
    fields:
      - name: admin-password
        onMissingValue: generate
        vaultPolicy: validatedPatternDefaultPolicy
      - name: login-password
        onMissingValue: generate
        vaultPolicy: validatedPatternDefaultPolicy

  # The PostgreSQL replication role. Created on the active primary, used by
  # the passive replica to stream WAL across the VAN. Same value both sides.
  - name: odoo-replicator
    vaultPrefixes:
      - global
    fields:
      - name: password
        onMissingValue: generate
        vaultPolicy: validatedPatternDefaultPolicy

  # VolSync rsync-tls pre-shared key, supplied to both the ReplicationSource
  # (active) and ReplicationDestination (passive).
  - name: odoo-volsync
    vaultPrefixes:
      - global
    fields:
      - name: psk
        onMissingValue: generate
        vaultPolicy: hexKey

  # ── Optional: Cloudflare edge failover (global.odooDR.cloudflare.enabled) ─
  # Used only by the hub (the passive site's failover triggers) and by
  # ansible/playbooks/06-cloudflare.yml. Leave commented out when Cloudflare is disabled.
  # - name: cloudflare
  #   vaultPrefixes:
  #     - hub
  #   fields:
  #     - name: api-token        # Account: Load Balancing Edit; Zone: DNS Edit
  #       value: null
  #     - name: account-id
  #       value: null
  #     - name: zone-id
  #       value: null
  #     - name: webhook-secret   # shared secret for the cf-webhook-auth header
  #       onMissingValue: generate
  #       vaultPolicy: validatedPatternDefaultPolicy
